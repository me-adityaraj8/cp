#include <iostream>
#include <set>
using namespace std;
 
int main() {
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        set<int> s;
        bool f = 0;
        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;
            if (s.count(x)) f = 1;
            s.insert(x);
        }
        cout << (f ? "YES
" : "NO
");
    }
    return 0;
}